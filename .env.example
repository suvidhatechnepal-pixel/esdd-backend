# Copy this file to .env on the VPS and fill in real values. Never commit .env itself.

PORT=3000
NODE_ENV=production

# Postgres - matches the DB/user created in Step 2.3
DATABASE_URL=postgresql://esdd_app:choose-a-strong-password-here@127.0.0.1:5432/esdd_console

# Used to sign login tokens - generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string

# How long a login session stays valid
JWT_EXPIRES_IN=12h

# Used server-side for the "Draft with AI" summary feature.
# Get one from https://console.anthropic.com (this is a *server* key, different
# from the artifact's built-in Claude access, which does not exist outside claude.ai)
ANTHROPIC_API_KEY=

# Comma-separated list of origins allowed to call this API (your frontend's URL)
CORS_ORIGIN=https://esdd.esgcommons.weflow.agency
